{
  "service": "CRM",
  "crmversion": "2.0",
  "locale": {
    "default": "en"
  },
  "orgVariables": [
    {
      "apiName": "civify_api_key",
      "displayName": "Civify API Key",
      "description": "API Key for Civify CV parsing service. Get it from your Civify account.",
      "type": "string",
      "value": ""
    },
    {
      "apiName": "civify_api_url",
      "displayName": "Civify API URL",
      "description": "Base URL for Civify API (optional, uses default if empty)",
      "type": "string",
      "value": "https://civify.cv/apis/v1/external/cvs"
    }
  ],
  "modules": {
    "Leads": {
      "relatedListWidget": {
        "widgetId": "civify_embed",
        "name": "Civify CV Parser"
      }
    },
    "Contacts": {
      "relatedListWidget": {
        "widgetId": "civify_embed",
        "name": "Civify CV Parser"
      }
    }
  },
  "buttons": [
    {
      "name": "Parse CV",
      "modules": ["Leads", "Contacts"],
      "location": "DetailViewButton",
      "action": {
        "type": "invoke.widget",
        "widget": "civify_popup"
      }
    }
  ],
  "widgets": [
    {
      "name": "Civify CV Popup",
      "widgetId": "civify_popup",
      "location": "popup",
      "html": "/app/widget.html"
    },
    {
      "name": "Civify CV Embed",
      "widgetId": "civify_embed",
      "location": "related_list",
      "html": "/app/widget.html",
      "logo": "",
      "icon": ""
    }
  ],
  "usedconnectors": [],
  "permissions": [
    "ZohoCRM.modules.ALL",
    "ZohoCRM.settings.ALL",
    "ZohoCRM.Files.READ",
    "ZohoCRM.Files.CREATE"
  ]
}
